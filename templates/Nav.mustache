{{#data-whale-nav}}
<nav class="whale-navbar">
	<a class="whale-navbar-brand" href="{{brand-href}}">
		<img class="whale-navbar-brand-logo" src="{{brand-logo}}" alt="{{brand-alt}}" decoding="async" fetchpriority="high">
	</a>
	<ul class="whale-navbar-menu">
		{{#items}}
			<li class="{{classes}}">
				{{{ html-link }}}
				{{#has-children}}
					<div class="whale-dropdown-menu" role="menu">
						{{#children}}
							<div class="{{classes}}">
								{{{ html-link }}}
								{{#has-children}}
									<div class="whale-dropdown-menu whale-dropdown-submenu" role="menu">
										{{#children}}
											<div class="{{classes}}">
												{{{ html-link }}}
											</div>
										{{/children}}
									</div>
								{{/has-children}}
							</div>
						{{/children}}
					</div>
				{{/has-children}}
			</li>
		{{/items}}
	</ul>
	{{>SearchBox}}
	{{#has-notifications}}
		<ul class="whale-navbar-notifications">
			{{#notifications}}
				{{{ html }}}
			{{/notifications}}
		</ul>
	{{/has-notifications}}
	{{>LoginMenu}}
</nav>
{{/data-whale-nav}}
